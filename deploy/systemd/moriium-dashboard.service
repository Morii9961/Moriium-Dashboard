# /etc/systemd/system/moriium-dashboard.service
# 前提：专用用户 moriium；代码在 /opt/moriium-dashboard/current（指向某个 releases/<提交>）；
# 数据与认证库在 /var/lib/moriium-dashboard；Node 版本满足 package.json 的 engines。

[Unit]
Description=Moriium Dashboard
After=network.target

[Service]
Type=simple
User=moriium
Group=moriium
WorkingDirectory=/opt/moriium-dashboard/current
EnvironmentFile=/etc/moriium-dashboard/dashboard.env
ExecStart=/usr/bin/node apps/server/src/main.ts
# main.ts 收到 SIGTERM 会关闭监听和数据库后退出。
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
# 认证库缺失或损坏时服务拒绝启动；不要让它无限重启刷日志。
StartLimitIntervalSec=300
StartLimitBurst=5

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/moriium-dashboard
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Node 的 JIT 需要可写可执行内存，所以不设 MemoryDenyWriteExecute。

[Install]
WantedBy=multi-user.target
