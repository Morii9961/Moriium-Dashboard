# /etc/moriium-dashboard/dashboard.env  （root:moriium，0640）
# 不在这里写口令或令牌。口令只由 Morii 用 pnpm auth:setup 在终端隐藏输入。

MORIIUM_DASHBOARD_DATA=/var/lib/moriium-dashboard/data
MORIIUM_DASHBOARD_PORT=5180

# 认证：部署时必须开启。认证库目录与数据目录分开，权限 0700。
MORIIUM_DASHBOARD_AUTH=required
MORIIUM_DASHBOARD_AUTH_DIR=/var/lib/moriium-dashboard/auth

# 对外来源：Nginx 上配置的 https 地址，不带路径。按选定的访问方式填写。
MORIIUM_DASHBOARD_PUBLIC_ORIGIN=https://dashboard.example.com

# Nginx 在本机转发并设置 X-Real-IP 时开启，fail2ban 才能看到真实来源。
MORIIUM_DASHBOARD_TRUST_PROXY=1
