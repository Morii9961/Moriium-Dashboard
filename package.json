{
  "name": "moriium-dashboard",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:public": "node scripts/audit-public.ts",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm audit:public",
    "build": "pnpm --filter @moriium-dashboard/web build",
    "server": "pnpm --filter @moriium-dashboard/server start",
    "server:dev": "pnpm --filter @moriium-dashboard/server dev",
    "dev": "pnpm --filter @moriium-dashboard/web dev",
    "specimen": "pnpm --filter @moriium-dashboard/web dev",
    "tokens": "node apps/web/scripts/gen-tokens.ts",
    "screenshots": "node scripts/screenshots.ts",
    "status:check": "node packages/protocol/src/cli/status-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
